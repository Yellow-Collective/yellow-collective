    "text": "<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/faf03b84e2600cdc.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/5f81746027f8fbe8.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-135d1571349ec3e1.js\"/><script src=\"/_next/static/chunks/d4c6d95f-915054d5ffa7dcac.js\" async=\"\"></script><script src=\"/_next/static/chunks/5106-f7ac8cc0b1fa392c.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-129e35c1bd196ca1.js\" async=\"\"></script><script src=\"/_next/static/chunks/f0c93e9a-0fba30d5b1037285.js\" async=\"\"></script><script src=\"/_next/static/chunks/2260-6a4f62a8f3fdac01.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-2d4a5adde11286c3.js\" async=\"\"></script><script async=\"\" src=\"https://www.googletagmanager.com/gtag/js?id=G-DF7PJS3WBD\"></script><script src=\"/_next/static/chunks/606-2394855c76274053.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/(docs)/reference/fname/api/page-8d3892d22f5da8c0.js\" async=\"\"></script><title>Farcaster Docs</title><meta name=\"description\" content=\"A protocol for building sufficiently decentralized social networks.\"/><meta property=\"og:title\" content=\"Farcaster Docs\"/><meta property=\"og:description\" content=\"A protocol for building sufficiently decentralized social networks.\"/><meta property=\"og:url\" content=\"https://docs.farcaster.xyz\"/><meta property=\"og:image\" content=\"https://docs.farcaster.xyz/og-image.png\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary\"/><meta name=\"twitter:site\" content=\"@farcaster_xyz\"/><meta name=\"twitter:title\" content=\"Farcaster Docs\"/><meta name=\"twitter:description\" content=\"A protocol for building sufficiently decentralized social networks.\"/><meta name=\"twitter:image\" content=\"https://docs.farcaster.xyz/og-image.png\"/><link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\"/><link rel=\"icon\" href=\"/icon.png\"/><script>window.dataLayer = window.dataLayer || [];\nfunction gtag(){dataLayer.push(arguments);}\ngtag('js', new Date());\ngtag('config', 'G-DF7PJS3WBD');</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><header class=\"top-nav\"><div class=\"top-nav-left\"><a class=\"top-nav-logo\" href=\"/\"><svg width=\"18\" height=\"15.819230769230769\" viewBox=\"0 0 520 457\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M519.801 0V61.6809H458.172V123.31H477.054V123.331H519.801V456.795H416.57L416.507 456.49L363.832 207.03C358.81 183.251 345.667 161.736 326.827 146.434C307.988 131.133 284.255 122.71 260.006 122.71H259.8C235.551 122.71 211.818 131.133 192.979 146.434C174.139 161.736 160.996 183.259 155.974 207.03L103.239 456.795H0V123.323H42.7471V123.31H61.6262V61.6809H0V0H519.801Z\" fill=\"currentColor\"></path></svg><span class=\"top-nav-logo-text\">Farcaster <span class=\"top-nav-logo-dim\">docs</span></span></a><nav class=\"top-nav-links\"><a class=\"top-nav-link\" href=\"/learn\">Learn</a><a class=\"top-nav-link\" href=\"/developers\">Build apps</a><a class=\"top-nav-link\" href=\"/auth-kit\">AuthKit</a><a class=\"top-nav-link\" href=\"/snap\">Snap</a><a class=\"top-nav-link active\" href=\"/reference\">Reference</a><a href=\"https://snapchain.farcaster.xyz/\" class=\"top-nav-link\" target=\"_blank\" rel=\"noopener noreferrer\">Snapchain<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-external-link\" aria-hidden=\"true\" style=\"margin-left:3px;opacity:0.5\"><path d=\"M1